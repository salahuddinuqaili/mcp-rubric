{
  "name": "@mcp-studio/cli",
  "version": "0.1.0",
  "description": "Postman + ESLint for MCP servers — CLI for web UI and CI scanning",
  "type": "module",
  "license": "MIT",
  "author": "Salahuddin Uqaili",
  "homepage": "https://github.com/salahuddinuqaili/mcp-studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/salahuddinuqaili/mcp-studio.git",
    "directory": "packages/cli"
  },
  "keywords": ["mcp", "model-context-protocol", "scanner", "linter", "cli", "developer-tools"],
  "bin": {
    "mcp-studio": "dist/index.js"
  },
  "files": ["dist/", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('../client/dist','dist/client',{recursive:true})\"",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@mcp-studio/server": "workspace:*",
    "@mcp-studio/shared": "workspace:*",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.7.3"
  }
}
