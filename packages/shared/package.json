{
  "name": "mcp-rubric-shared",
  "version": "0.2.0",
  "description": "Shared types, schemas, and constants for Rubric",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "author": "Salahuddin Uqaili",
  "homepage": "https://github.com/salahuddinuqaili/mcp-rubric",
  "repository": {
    "type": "git",
    "url": "https://github.com/salahuddinuqaili/mcp-rubric.git",
    "directory": "packages/shared"
  },
  "keywords": ["mcp", "model-context-protocol", "types", "shared"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist/", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
