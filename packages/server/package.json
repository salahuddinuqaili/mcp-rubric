{
  "name": "mcp-studio-server",
  "version": "0.1.0",
  "description": "Hono backend for MCP Studio — connection manager, scanner engine, and SQLite persistence",
  "type": "module",
  "license": "MIT",
  "author": "Salahuddin Uqaili",
  "homepage": "https://github.com/salahuddinuqaili/mcp-studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/salahuddinuqaili/mcp-studio.git",
    "directory": "packages/server"
  },
  "keywords": ["mcp", "model-context-protocol", "scanner", "hono", "backend"],
  "exports": {
    "./app.js": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    },
    "./mcp/connection-manager.js": {
      "types": "./dist/mcp/connection-manager.d.ts",
      "import": "./dist/mcp/connection-manager.js"
    },
    "./scanner/index.js": {
      "types": "./dist/scanner/index.d.ts",
      "import": "./dist/scanner/index.js"
    }
  },
  "files": ["dist/", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@hono/node-ws": "^1.3.1",
    "mcp-studio-shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "better-sqlite3": "^11.8.1",
    "hono": "^4.7.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "tsx": "^4.19.4",
    "typescript": "^5.7.3"
  }
}
