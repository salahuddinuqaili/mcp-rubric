{
  "name": "@mcp-studio/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./app.js": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    },
    "./mcp/connection-manager.js": {
      "types": "./dist/mcp/connection-manager.d.ts",
      "import": "./dist/mcp/connection-manager.js"
    },
    "./scanner/index.js": {
      "types": "./dist/scanner/index.d.ts",
      "import": "./dist/scanner/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@hono/node-ws": "^1.3.1",
    "@mcp-studio/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "better-sqlite3": "^11.8.1",
    "hono": "^4.7.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "tsx": "^4.19.4",
    "typescript": "^5.7.3"
  }
}
